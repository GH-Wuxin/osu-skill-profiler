# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Build artifacts
build/
dist/

# Generated dataset/training artifacts (never commit large or derived data)
training/datasets/*
!training/datasets/.gitkeep
# The v0.40 runtime is reproducible from this bounded packaged calibration.
!training/datasets/map_demand_calibration_v04_unbounded_star_scale_20k/
!training/datasets/map_demand_calibration_v04_unbounded_star_scale_20k/*
training/splits/*
!training/splits/.gitkeep
training/weak_labels/*
!training/weak_labels/.gitkeep

# Local outputs from CLI smoke tests
out/
*.profile.json

# Agent progress checkpoints (never commit)
tmp/

# Machine-specific private-chat operator helpers (QQ identities; not algorithm source)
tools/pippi-owner-watch*
